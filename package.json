{
  "name": "@alisdev/be-kit",
  "version": "2.0.3",
  "description": "All-in-one backend utility kit for Node.js + TypeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alis-Dev-idn/be-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Alis-Dev-idn/be-kit/issues"
  },
  "homepage": "https://github.com/Alis-Dev-idn/be-kit#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "turbo run build && tsup src/index.ts --format cjs,esm --dts",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "publish:pkg": "pnpm build && npm publish --access public"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.4",
    "mongoose": "^8.10.1"
  },
  "peerDependencies": {
    "express": "^4.x || ^5.x",
    "fastify": "^4.x || ^5.x",
    "nodemailer": "^6.x",
    "resend": "^3.x",
    "redis": "^4.x",
    "bullmq": "^5.x",
    "node-cron": "^3.x",
    "eventemitter2": "^6.x",
    "socket.io": "^4.x",
    "ws": "^8.x"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "fastify": { "optional": true },
    "nodemailer": { "optional": true },
    "resend": { "optional": true },
    "redis": { "optional": true },
    "bullmq": { "optional": true },
    "node-cron": { "optional": true },
    "eventemitter2": { "optional": true },
    "socket.io": { "optional": true },
    "ws": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^20.17.22",
    "turbo": "^2.4.4",
    "tsup": "^8.4.0"
  },
  "packageManager": "pnpm@9.1.0"
}
